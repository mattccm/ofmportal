# ===========================================
# PRODUCTION DEPLOYMENT GUIDE
# ===========================================
# 1. Copy this to .env.local for local dev
# 2. Add these to Vercel Environment Variables for production
# ===========================================

# Database (Supabase PostgreSQL)
# Get from: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Realtime (Optional but recommended - reduces database egress by ~90%)
# Get from: Supabase Dashboard → Settings → API
# These enable real-time notifications, messages, and typing indicators via WebSocket
# Without these, the app falls back to 5-minute polling
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# NextAuth.js
# NEXTAUTH_URL = your production domain
# NEXTAUTH_SECRET = run: openssl rand -base64 32
NEXTAUTH_URL="https://portal.of-m.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Cloudflare R2 Storage
# Get from: Cloudflare Dashboard → R2 → Overview → Manage R2 API Tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="of-m-portal"
# R2_PUBLIC_DOMAIN is REQUIRED for avatars and branding assets to work
# Options:
# 1. Connect a custom domain in R2 settings (e.g., "assets.of-m.com")
# 2. Enable public access and use r2.dev URL (e.g., "pub-xxxxx.r2.dev")
R2_PUBLIC_DOMAIN="assets.of-m.com"

# Resend (Email) - Free tier: 3,000 emails/month
# Get from: resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@of-m.com"

# Twilio (SMS) - Optional
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# App Settings
APP_URL="https://portal.of-m.com"
APP_NAME="OF-M Creator Portal"

# --- Creator Verify guide (/creatorverify) ---
# Access password the creator types to open the guide.
CREATORVERIFY_PASSWORD=
# The SOCKS5 proxy the guide shows (only revealed after the password is correct).
CV_PROXY_HOST=
CV_PROXY_PORT=
CV_PROXY_USER=
CV_PROXY_PASS=
# Free iOS app name shown in the steps (default: Potatso).
CV_PROXY_APP=Potatso
# The exit IP the creator should see in step 4 (optional but recommended).
CV_EXPECT_IP=
